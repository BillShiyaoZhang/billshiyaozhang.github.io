{% assign current_lang = page.lang | default: 'en' %}
{% assign ui = site.data.ui[current_lang] %}
<header>
  <nav
    id="navbar"
    class="navbar navbar-light navbar-expand-lg {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}"
    aria-label="{{ ui.navigation }}"
  >
    <div class="container">
      <a class="navbar-brand title" href="{{ '/' | localized_url: current_lang | relative_url }}">{{ ui.name }}</a>
      <div class="navbar-controls order-lg-last">
        {% if page.alternate_url %}
          <a
            class="language-switch"
            id="language-switch"
            href="{{ page.alternate_url | relative_url }}"
            lang="{% if current_lang == 'en' %}zh-CN{% else %}en{% endif %}"
            hreflang="{% if current_lang == 'en' %}zh-CN{% else %}en{% endif %}"
            aria-label="{{ ui.switch }}"
          >
            {{- ui.switch_label -}}
          </a>
        {% endif %}
        <button
          class="navbar-toggler collapsed"
          type="button"
          data-toggle="collapse"
          data-target="#navbarNav"
          aria-controls="navbarNav"
          aria-expanded="false"
          aria-label="{{ ui.menu }}"
        >
          <span class="icon-bar top-bar"></span><span class="icon-bar middle-bar"></span><span class="icon-bar bottom-bar"></span>
        </button>
      </div>
      <div class="collapse navbar-collapse text-right" id="navbarNav">
        <ul class="navbar-nav ml-auto flex-nowrap">
          <li class="nav-item {% if page.locale_key == 'about' %}active{% endif %}">
            <a
              class="nav-link"
              href="{{ '/' | localized_url: current_lang | relative_url }}"
              {% if page.locale_key == 'about' %}
                aria-current="page"
              {% endif %}
            >
              {{- ui.home -}}
            </a>
          </li>
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% assign nav_lang = p.lang | default: 'en' %}
            {% if p.nav and p.autogen == null and nav_lang == current_lang %}
              <li class="nav-item {% if page.locale_key == p.locale_key %}active{% endif %}">
                <a
                  class="nav-link"
                  href="{{ p.url | relative_url }}"
                  {% if page.locale_key == p.locale_key %}
                    aria-current="page"
                  {% endif %}
                >
                  {{- p.title -}}
                </a>
              </li>
            {% endif %}
          {% endfor %}
          {% if site.search_enabled %}
            <li class="nav-item">
              <button id="search-toggle" title="{{ ui.search }}" aria-label="{{ ui.search }}" onclick="openSearchModal()">
                <span class="nav-link">ctrl k <i class="ti ti-search" aria-hidden="true"></i></span>
              </button>
            </li>
          {% endif %}
          {% if site.enable_darkmode %}
            <li class="toggle-container">
              <button id="light-toggle" title="{{ ui.change_theme }}" aria-label="{{ ui.change_theme }}">
                <i class="ti ti-sun-moon" id="light-toggle-system" aria-hidden="true"></i
                ><i class="ti ti-moon-filled" id="light-toggle-dark" aria-hidden="true"></i
                ><i class="ti ti-sun-filled" id="light-toggle-light" aria-hidden="true"></i>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
</header>
