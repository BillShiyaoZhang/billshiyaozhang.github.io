{% if site.bib_search %}
  {% assign current_lang = page.lang | default: 'en' %}
  {% assign ui = site.data.ui[current_lang] %}
  <script src="{{ '/assets/js/bibsearch.js' | relative_url | bust_file_cache }}" type="module"></script>
  <label for="bibsearch" class="sr-only">{{ ui.publication_search }}</label>
  <input
    type="search"
    id="bibsearch"
    spellcheck="false"
    autocomplete="off"
    class="search bibsearch-form-input"
    placeholder="{{ ui.publication_prompt }}"
  >
{% endif %}
