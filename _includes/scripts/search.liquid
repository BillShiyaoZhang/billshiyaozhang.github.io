{% if site.search_enabled %}
  {% assign current_lang = page.lang | default: 'en' %}
  {% assign ui = site.data.ui[current_lang] %}
  <script type="module" src="{{ '/assets/js/search/ninja-keys.min.js' | relative_url | bust_file_cache }}"></script>
  <ninja-keys hideBreadcrumbs noAutoLoadMdIcons placeholder="{{ ui.search_prompt }}">
    <div slot="footer" class="search-shortcuts">
      <span><kbd>↵</kbd> {{ ui.select_result }}</span>
      <span><kbd>↑ ↓</kbd> {{ ui.navigate_results }}</span>
      <span><kbd>esc</kbd> {{ ui.close_search }}</span>
    </div>
  </ninja-keys>
  <script>
    const ninjaKeys = document.querySelector('ninja-keys');
    if (determineComputedTheme() === 'dark') ninjaKeys.classList.add('dark');
    const openSearchModal = () => {
      const navbar = $('#navbarNav');
      if (navbar.hasClass('show')) navbar.collapse('hide');
      ninjaKeys.open();
    };
    const ninja = ninjaKeys;
    ninja.data = [
      {id: 'nav-home', title: {{ ui.home | jsonify }}, section: {{ ui.navigation | jsonify }}, handler: () => {window.location.href = {{ '/' | localized_url: current_lang | relative_url | jsonify }};}},
      {% assign sorted_pages = site.pages | sort: 'nav_order' %}
      {% for p in sorted_pages %}{% if p.nav and p.lang == current_lang %}
        {id: {{ p.locale_key | prepend: 'nav-' | jsonify }}, title: {{ p.title | jsonify }}, description: {{ p.description | jsonify }}, section: {{ ui.navigation | jsonify }}, handler: () => {window.location.href = {{ p.url | relative_url | jsonify }};}},
      {% endif %}{% endfor %}
      {% for project in site.data.projects %}
        {% assign project_text = project %}{% if current_lang == 'zh-CN' %}{% assign project_text = project.zh %}{% endif %}
        {id: {{ project.id | prepend: 'project-' | jsonify }}, title: {{ project_text.name | jsonify }}, description: {{ project_text.summary | jsonify }}, section: {{ ui.projects | jsonify }}, handler: () => {window.location.href = {{ '/projects/#' | append: project.id | localized_url: current_lang | relative_url | jsonify }};}},
      {% endfor %}
      {id:'email',title:{{ ui.email | jsonify }},section:{{ ui.socials | jsonify }},handler:()=>{window.location.href={{ site.email | prepend: 'mailto:' | jsonify }};}},
      {id:'scholar',title:'Google Scholar',section:{{ ui.socials | jsonify }},handler:()=>{window.open('https://scholar.google.com/citations?user=OCfMc6oAAAAJ','_blank','noopener');}},
      {id:'github',title:'GitHub',section:{{ ui.socials | jsonify }},handler:()=>{window.open('https://github.com/BillShiyaoZhang','_blank','noopener');}},
      {id:'orcid',title:'ORCID',section:{{ ui.socials | jsonify }},handler:()=>{window.open('https://orcid.org/0009-0000-1591-3759','_blank','noopener');}},
      {id:'light-theme',title:{{ ui.light_theme | jsonify }},section:{{ ui.theme | jsonify }},handler:()=>{setThemeSetting('light');}},
      {id:'dark-theme',title:{{ ui.dark_theme | jsonify }},section:{{ ui.theme | jsonify }},handler:()=>{setThemeSetting('dark');}},
      {id:'system-theme',title:{{ ui.system_theme | jsonify }},section:{{ ui.theme | jsonify }},handler:()=>{setThemeSetting('system');}}
    ];
  </script>
  <script src="{{ '/assets/js/shortcut-key.js' | relative_url | bust_file_cache }}"></script>
{% endif %}
